## Data Mutations

**ALL database mutations (INSERT, UPDATE, DELETE) MUST be done through Server Actions that call mutation helper functions.**

### ✅ CORRECT: Mutation Helper Functions

First, create mutation helper functions in `db/queries`:

```typescript
// db/queries/deck-mutations.ts
import { db } from '@/db';
import { decks } from '@/db/schema';
import { eq, and } from 'drizzle-orm';

/**
 * Insert a new deck for a user
 */
export async function insertDeck(data: {
  title: string;
  description?: string;
  userId: string;
}) {
  const [newDeck] = await db
    .insert(decks)
    .values({
      ...data,
      createdAt: new Date(),
      updatedAt: new Date(),
    })
    .returning();
  
  return newDeck;
}

/**
 * Update a deck (with ownership verification)
 */
export async function updateDeckById(
  deckId: number,
  userId: string,
  data: {
    title?: string;
    description?: string;
  }
) {
  const [updated] = await db
    .update(decks)
    .set({
      ...data,
      updatedAt: new Date(),
    })
    .where(and(
      eq(decks.id, deckId),
      eq(decks.userId, userId)
    ))
    .returning();
  
  return updated || null;
}

/**
 * Delete a deck (with ownership verification)
 */
export async function deleteDeckById(deckId: number, userId: string) {
  const result = await db
    .delete(decks)
    .where(and(
      eq(decks.id, deckId),
      eq(decks.userId, userId)
    ))
    .returning();
  
  return result.length > 0;
}
```

### ✅ CORRECT: Server Actions Calling Mutation Helpers

```typescript
// app/actions/deck-actions.ts
'use server';

import { auth } from '@clerk/nextjs/server';
import { revalidatePath } from 'next/cache';
import { z } from 'zod';
import { insertDeck, updateDeckById, deleteDeckById } from '@/db/queries/deck-mutations';

// 1. Define Zod schema for validation
const createDeckSchema = z.object({
  title: z.string().min(1, 'Title is required').max(100),
  description: z.string().max(500).optional(),
});

// 2. Define TypeScript type from schema
type CreateDeckInput = z.infer<typeof createDeckSchema>;

// 3. Server action with typed input and validation
export async function createDeck(input: CreateDeckInput) {
  // Validate input with Zod
  const validated = createDeckSchema.parse(input);
  
  // Get authenticated user
  const { userId } = await auth();
  if (!userId) {
    throw new Error('Unauthorized');
  }
  
  // Call mutation helper function
  const newDeck = await insertDeck({
    title: validated.title,
    description: validated.description,
    userId,
  });
  
  // Revalidate the page cache
  revalidatePath('/dashboard');
  
  return { success: true, deck: newDeck };
}

// UPDATE example
const updateDeckSchema = z.object({
  id: z.number(),
  title: z.string().min(1).max(100),
  description: z.string().max(500).optional(),
});

type UpdateDeckInput = z.infer<typeof updateDeckSchema>;

export async function updateDeck(input: UpdateDeckInput) {
  const validated = updateDeckSchema.parse(input);
  const { userId } = await auth();
  
  if (!userId) {
    throw new Error('Unauthorized');
  }
  
  // Call mutation helper function
  const updated = await updateDeckById(
    validated.id,
    userId,
    {
      title: validated.title,
      description: validated.description,
    }
  );
  
  if (!updated) {
    throw new Error('Deck not found or access denied');
  }
  
  revalidatePath('/dashboard');
  return { success: true, deck: updated };
}

// DELETE example
const deleteDeckSchema = z.object({
  id: z.number(),
});

type DeleteDeckInput = z.infer<typeof deleteDeckSchema>;

export async function deleteDeck(input: DeleteDeckInput) {
  const validated = deleteDeckSchema.parse(input);
  const { userId } = await auth();
  
  if (!userId) {
    throw new Error('Unauthorized');
  }
  
  // Call mutation helper function
  const deleted = await deleteDeckById(validated.id, userId);
  
  if (!deleted) {
    throw new Error('Deck not found or access denied');
  }
  
  revalidatePath('/dashboard');
  return { success: true };
}
```

